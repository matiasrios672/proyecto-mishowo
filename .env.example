# Copiá a .env (backend) y .env.local (frontend) según corresponda. Nunca subas secretos.

# --- backend ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://mishowo:mishowo@localhost:5432/mishowo
FRONTEND_ORIGIN=http://localhost:3000
# En producción: .mishowo.com (cookie compartida entre subdominios)
COOKIE_DOMAIN=
# Dominio raíz (prod: mishowo.com). Sus subdominios pueden llamar a la API.
ROOT_DOMAIN=localhost
UPLOADS_DIR=./uploads

# Emails (en desarrollo: Mailpit en localhost:1025, se ven en http://localhost:8025)
APP_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="MiShowo <no-reply@mishowo.com>"
SESSION_DAYS=30
AUTH_PER_MINUTE=10

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL interna del backend para el render del servidor
API_URL=http://localhost:4000
