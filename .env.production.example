# Variables de producción (Coolify > Environment Variables). Nunca subas el .env real.
ROOT_DOMAIN=mishowo.com

# Base de datos
POSTGRES_PASSWORD=            # openssl rand -hex 24

# Secretos (generá cada uno distinto)
REVALIDATE_SECRET=            # openssl rand -hex 24  (mínimo 16 caracteres)
ADMIN_SECRET_KEY=             # openssl rand -base64 32  (cifra los secretos 2FA del admin)
ADMIN_ALLOWED_IPS=            # opcional: IPs permitidas para /admin, separadas por coma

# Emails (SMTP real; en producción no usar Mailpit)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false             # true si el puerto es 465
MAIL_FROM="MiShowo <no-reply@mishowo.com>"

# Datos legales y de contacto que se ven en la web (se incrustan al compilar)
LEGAL_ENTITY=                 # razón social, CUIT y domicilio (revisar con un abogado)
SUPPORT_WHATSAPP=             # con código de país, sin + (ej. 5491155550000)
